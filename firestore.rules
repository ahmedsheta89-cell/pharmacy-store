rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isManager() {
      return request.auth != null && request.auth.token.email == "ahmedsheta89@gmail.com";
    }
    // Private customer records are never readable without manager identity.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasAll(['customer_name', 'customer_phone', 'customer_address', 'total', 'items', 'status', 'code'])
        && request.resource.data.customer_name is string
        && request.resource.data.customer_name.size() <= 100
        && request.resource.data.customer_phone is string
        && request.resource.data.customer_phone.size() <= 20
        && request.resource.data.customer_address is string
        && request.resource.data.customer_address.size() <= 500
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 1000000
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50
        && request.resource.data.status == 'new'
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 20;
      allow read, update, delete: if isManager();
    }

    // Product catalog: readable by every visitor, writable only by the signed-in manager.
    match /products/{productId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Only a minimal status record is public. Its SHA-256 document key requires
    // the order code and normalized phone. Collection listing is never public.
    match /tracking/{trackingId} {
      allow get: if true;
      allow list: if isManager();
      allow create: if
        request.resource.data.keys().hasOnly(['order_id', 'status', 'total', 'created_at'])
        && request.resource.data.order_id is string
        && request.resource.data.status == 'new'
        && request.resource.data.total is number
        && request.resource.data.created_at is string
        && trackingId.size() == 64
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.order_id)).data.tracking_id == trackingId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.order_id)).data.total == request.resource.data.total;
      allow update, delete: if isManager();
    }
  }
}
