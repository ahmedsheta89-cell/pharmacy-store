rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isManager() {
      return request.auth != null && request.auth.token.email == "ahmedsheta89@gmail.com";
    }
    // Private customer records are never readable without manager identity.
    match /orders/{orderId} {
      // Checkout is validated by the free Worker backend using a dedicated service identity.
      allow create: if false;
      allow read, update, delete: if isManager();
    }

    // Product catalog: readable by every visitor, writable only by the signed-in manager.
    match /products/{productId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Only a minimal status record is public. Its SHA-256 document key requires
    // the order code and normalized phone. Collection listing is never public.
    match /tracking/{trackingId} {
      allow get: if true;
      allow list: if isManager();
      allow create: if false;
      allow update, delete: if isManager();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isManager();
    }
    match /feedback/{trackingId} {
      allow read, update, delete: if isManager();
      allow create: if request.resource.data.keys().hasOnly(['rating','comment','created_at'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000
        && request.resource.data.created_at is string
        && get(/databases/$(database)/documents/tracking/$(trackingId)).data.status == 'delivered';
    }
  }
}
