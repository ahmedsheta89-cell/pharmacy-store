{
  "name": "oneforallgood-assistant",
  "main": "index.js",
  "compatibility_date": "2026-11-21",
  "account_id": "996f291849de336a2d6a75925d7f5a07",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": false
  },
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "ORDER_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "POS_SYNC_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "vars": {
    "POS_SYNC_ENABLED": "false"
  }
}
